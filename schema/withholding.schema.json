{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/open-withholding/schema/withholding.schema.json",
  "title": "Withholding parameter file",
  "description": "One jurisdiction-year(-revision) income tax withholding parameter set. Draft v0.1 \u2014 org URL in $id is a placeholder.",
  "type": "object",
  "required": [
    "schema_version",
    "jurisdiction",
    "tax",
    "effective_from",
    "method",
    "params"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^US(-[A-Z]{2})?(-[A-Z0-9-]+)?$",
      "description": "US, US-<state>, or US-<state>-<local id> (e.g. US-PA-PSD-700102)"
    },
    "tax": {
      "enum": [
        "federal_income_withholding",
        "state_income_withholding",
        "local_income_withholding"
      ]
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Repo-relative path of the file this replaces"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "description": "Multi-document provenance (v0.2): every parameter must be traceable to one of these; single-document files keep `source`",
      "items": {
        "$ref": "#/$defs/sourceBlock"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "document",
        "url",
        "retrieved",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "method": {
      "type": "string",
      "description": "Registered method name; params validated against the matching $defs entry",
      "enum": [
        "flat_rate",
        "flat_rate_with_annual_allowance",
        "annualized_percentage",
        "annualized_percentage_phaseout",
        "annualized_subtraction_percentage",
        "annualized_percentage_with_credits",
        "per_period_percentage",
        "elective_flat_rate",
        "per_period_credit_phaseout",
        "deduction_constant_percentage",
        "rate_schedule_percentage",
        "federal_percentage_2020",
        "federal_percentage_pre2020",
        "wage_bracket_lookup",
        "custom"
      ]
    },
    "custom_implementation": {
      "type": "string",
      "description": "Required iff method == custom; e.g. custom/us_ct"
    },
    "params": {
      "type": "object"
    },
    "rounding": {
      "type": "object",
      "required": [
        "to",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "to": {
          "$ref": "#/$defs/money",
          "description": "Round to nearest multiple, e.g. \"1.00\" or \"0.01\""
        },
        "mode": {
          "enum": [
            "nearest",
            "up",
            "down",
            "half_even"
          ]
        },
        "intermediate": {
          "enum": [
            "none",
            "annual"
          ],
          "default": "none"
        },
        "intermediate_to": {
          "$ref": "#/$defs/money",
          "description": "Granularity for the intermediate (annual) rounding when it differs from `to` \u2014 e.g. VA rounds the annual tax to \"1.00\" but the final amount to \"0.01\""
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Provenance is mandatory: exactly one of source / sources",
      "oneOf": [
        {
          "required": [
            "source"
          ],
          "not": {
            "required": [
              "sources"
            ]
          }
        },
        {
          "required": [
            "sources"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "flat_rate"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "rate"
            ],
            "additionalProperties": false,
            "properties": {
              "rate": {
                "$ref": "#/$defs/rate"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "flat_rate_with_annual_allowance"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "rate",
              "filing_status"
            ],
            "additionalProperties": false,
            "properties": {
              "rate": {
                "$ref": "#/$defs/rate"
              },
              "filing_status": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "annual_allowance"
                  ],
                  "properties": {
                    "annual_allowance": {
                      "$ref": "#/$defs/money"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "annualized_percentage"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "brackets"
            ],
            "additionalProperties": false,
            "properties": {
              "standard_deduction": {
                "$ref": "#/$defs/perStatusMoney"
              },
              "allowance_amount": {
                "$ref": "#/$defs/moneyOrNull"
              },
              "secondary_allowance_amount": {
                "$ref": "#/$defs/moneyOrNull",
                "description": "Per second-kind allowance (e.g. IL-W-4 Line 2), where the jurisdiction defines one"
              },
              "elected_amount_treatment": {
                "enum": [
                  "wage_reduction"
                ],
                "description": "How the input's elected_annual_amount is consumed (MS 89-350 exemption dollars reduce wages)"
              },
              "percent_deduction": {
                "type": "object",
                "description": "Percentage-of-annual-wages deduction with a cap, optionally gated on claiming at least one allowance (SC)",
                "required": [
                  "rate",
                  "cap"
                ],
                "additionalProperties": false,
                "properties": {
                  "rate": {
                    "$ref": "#/$defs/rate"
                  },
                  "cap": {
                    "$ref": "#/$defs/money"
                  },
                  "requires_allowances": {
                    "type": "boolean",
                    "default": false
                  }
                }
              },
              "credit_per_allowance": {
                "$ref": "#/$defs/moneyOrNull"
              },
              "brackets": {
                "type": "object",
                "minProperties": 1,
                "description": "Keyed by this jurisdiction's filing-status enum",
                "additionalProperties": {
                  "$ref": "#/$defs/bracketTable"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "annualized_percentage_phaseout"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "deduction_phaseout",
              "brackets"
            ],
            "additionalProperties": false,
            "properties": {
              "deduction_phaseout": {
                "type": "object",
                "minProperties": 1,
                "description": "Keyed by filing status; deduction = maximum until phase_start, then shrinks by phase_rate per dollar, floored at 0",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "maximum",
                    "phase_start",
                    "phase_rate"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "maximum": {
                      "$ref": "#/$defs/money"
                    },
                    "phase_start": {
                      "$ref": "#/$defs/money"
                    },
                    "phase_rate": {
                      "$ref": "#/$defs/rate"
                    }
                  }
                }
              },
              "exemption_amount": {
                "$ref": "#/$defs/moneyOrNull"
              },
              "brackets": {
                "type": "object",
                "minProperties": 1,
                "description": "Keyed by filing status; a single schedule for all statuses uses the key \"all\"",
                "additionalProperties": {
                  "$ref": "#/$defs/bracketTable"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "elective_flat_rate"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "allowed_rates"
            ],
            "additionalProperties": false,
            "properties": {
              "allowed_rates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/rate"
                }
              },
              "zero_rate_allowed": {
                "type": "boolean",
                "default": false
              },
              "default_rate": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/rate"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "annualized_subtraction_percentage"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "standard_deduction",
              "midrange_snap",
              "table"
            ],
            "additionalProperties": false,
            "properties": {
              "standard_deduction": {
                "$ref": "#/$defs/money"
              },
              "credit_per_allowance": {
                "$ref": "#/$defs/moneyOrNull"
              },
              "midrange_snap": {
                "type": "object",
                "required": [
                  "bracket_size",
                  "midpoint",
                  "snap_below"
                ],
                "additionalProperties": false,
                "properties": {
                  "bracket_size": {
                    "$ref": "#/$defs/money"
                  },
                  "midpoint": {
                    "$ref": "#/$defs/money"
                  },
                  "snap_below": {
                    "$ref": "#/$defs/money"
                  }
                }
              },
              "table": {
                "type": "array",
                "minItems": 1,
                "description": "Printed rate-minus-subtraction rows, `from` ascending from 0",
                "items": {
                  "type": "object",
                  "required": [
                    "from",
                    "rate"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "$ref": "#/$defs/money"
                    },
                    "rate": {
                      "$ref": "#/$defs/rate"
                    },
                    "subtract": {
                      "$ref": "#/$defs/moneyOrNull"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "per_period_credit_phaseout"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "rate",
              "phase_rate",
              "schedules"
            ],
            "additionalProperties": false,
            "properties": {
              "rate": {
                "$ref": "#/$defs/rate"
              },
              "phase_rate": {
                "$ref": "#/$defs/rate"
              },
              "schedules": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "object",
                      "required": [
                        "base_allowance",
                        "phase_start"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "base_allowance": {
                          "$ref": "#/$defs/money"
                        },
                        "phase_start": {
                          "$ref": "#/$defs/money"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "deduction_constant_percentage"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "rate",
              "exemptions",
              "periods_per_year"
            ],
            "additionalProperties": false,
            "properties": {
              "rate": {
                "$ref": "#/$defs/rate"
              },
              "exemptions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "$ref": "#/$defs/money"
                }
              },
              "periods_per_year": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "rate_schedule_percentage"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "exemption_per_period",
              "standard_deduction_per_period",
              "no_withholding_floor",
              "status_groups",
              "schedules"
            ],
            "additionalProperties": false,
            "properties": {
              "exemption_per_period": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "$ref": "#/$defs/money"
                  }
                }
              },
              "standard_deduction_per_period": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "$ref": "#/$defs/money"
                  }
                }
              },
              "no_withholding_floor": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "$ref": "#/$defs/money"
                  }
                }
              },
              "status_groups": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "schedules": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "patternProperties": {
                    "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "$ref": "#/$defs/bracketTable"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "per_period_percentage"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "brackets"
            ],
            "additionalProperties": false,
            "properties": {
              "standard_deduction": {
                "$ref": "#/$defs/perStatusMoney",
                "description": "ANNUAL per-status exemption, divided by the period count at computation time (cent-rounded)"
              },
              "allowance_amount": {
                "$ref": "#/$defs/moneyOrNull",
                "description": "ANNUAL per-allowance amount, divided with standard_deduction"
              },
              "credit_per_allowance": {
                "$ref": "#/$defs/moneyOrNull",
                "description": "ANNUAL per-allowance tax credit, prorated per period (IA legacy W-4s: $40/allowance)"
              },
              "elected_amount_treatment": {
                "enum": [
                  "tax_credit"
                ],
                "description": "How the input's elected_annual_amount is consumed (IA W-4 dollars, prorated per period, subtracted from tax)"
              },
              "allowance_cliff_annual_wages": {
                "$ref": "#/$defs/moneyOrNull",
                "description": "Annualized-wage threshold above which the allowance value becomes exactly $0 (RI's cliff)"
              },
              "allowance_amounts_per_period": {
                "type": "object",
                "description": "The printed per-period value of one allowance, keyed by frequency",
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "$ref": "#/$defs/money"
                  }
                }
              },
              "brackets": {
                "type": "object",
                "minProperties": 1,
                "description": "Per-period tables: frequency -> filing status (or 'all') -> rows",
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "$ref": "#/$defs/bracketTable"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "federal_percentage_2020"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "wage_adjustment",
              "brackets"
            ],
            "additionalProperties": false,
            "properties": {
              "wage_adjustment": {
                "$ref": "#/$defs/perStatusMoney",
                "description": "Worksheet 1A line 1g amounts per filing status, applied when the Step 2 checkbox is NOT checked"
              },
              "brackets": {
                "type": "object",
                "required": [
                  "standard",
                  "step2_checkbox"
                ],
                "additionalProperties": false,
                "properties": {
                  "standard": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "$ref": "#/$defs/bracketTable"
                    }
                  },
                  "step2_checkbox": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "$ref": "#/$defs/bracketTable"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "custom"
          }
        }
      },
      "then": {
        "required": [
          "custom_implementation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "custom_implementation": {
            "const": "custom/us_al"
          }
        },
        "required": [
          "custom_implementation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "statuses",
              "dependent_tiers"
            ],
            "additionalProperties": false,
            "properties": {
              "statuses": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(zero|s|ms|m|h)$": {
                    "type": "object",
                    "required": [
                      "personal_exemption",
                      "standard_deduction",
                      "brackets"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "personal_exemption": {
                        "$ref": "#/$defs/money"
                      },
                      "standard_deduction": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "at_least",
                            "amount"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "at_least": {
                              "$ref": "#/$defs/money"
                            },
                            "amount": {
                              "$ref": "#/$defs/money"
                            }
                          }
                        }
                      },
                      "brackets": {
                        "$ref": "#/$defs/bracketTable"
                      }
                    }
                  }
                }
              },
              "dependent_tiers": {
                "$ref": "#/$defs/rangeRows"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "custom_implementation": {
            "const": "custom/us_or"
          }
        },
        "required": [
          "custom_implementation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "credit_per_allowance",
              "statuses",
              "status_groups"
            ],
            "additionalProperties": false,
            "properties": {
              "credit_per_allowance": {
                "$ref": "#/$defs/money"
              },
              "statuses": {
                "type": "object",
                "required": [
                  "single",
                  "married"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^(single|married)$": {
                    "type": "object",
                    "required": [
                      "allowance_zero_above",
                      "fed_subtraction_phaseout"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "allowance_zero_above": {
                        "$ref": "#/$defs/money"
                      },
                      "fed_subtraction_phaseout": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "at_least",
                            "cap"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "at_least": {
                              "$ref": "#/$defs/money"
                            },
                            "cap": {
                              "$ref": "#/$defs/money"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "status_groups": {
                "type": "object",
                "required": [
                  "single_under_3",
                  "married_or_single_3plus"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^(single_under_3|married_or_single_3plus)$": {
                    "type": "object",
                    "required": [
                      "standard_deduction",
                      "wage_tiers"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "standard_deduction": {
                        "$ref": "#/$defs/money"
                      },
                      "wage_tiers": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "wages_at_least",
                            "formulas"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "wages_at_least": {
                              "$ref": "#/$defs/money"
                            },
                            "formulas": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "required": [
                                  "at_least",
                                  "base",
                                  "rate",
                                  "excess_over"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "at_least": {
                                    "$ref": "#/$defs/money"
                                  },
                                  "base": {
                                    "$ref": "#/$defs/money"
                                  },
                                  "rate": {
                                    "$ref": "#/$defs/rate"
                                  },
                                  "excess_over": {
                                    "$ref": "#/$defs/money"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "custom_implementation": {
            "const": "custom/us_ca"
          }
        },
        "required": [
          "custom_implementation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "low_income_exemption",
              "estimated_deduction",
              "standard_deduction",
              "exemption_allowance",
              "brackets"
            ],
            "additionalProperties": false,
            "properties": {
              "low_income_exemption": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "object",
                    "required": [
                      "single",
                      "married_allowances_0_1",
                      "married_allowances_2_plus",
                      "head_of_household"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "single": {
                        "$ref": "#/$defs/money"
                      },
                      "married_allowances_0_1": {
                        "$ref": "#/$defs/money"
                      },
                      "married_allowances_2_plus": {
                        "$ref": "#/$defs/money"
                      },
                      "head_of_household": {
                        "$ref": "#/$defs/money"
                      }
                    }
                  }
                }
              },
              "estimated_deduction": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/money"
                    }
                  }
                },
                "description": "Table 2 amounts for counts 1..N (index = count); beyond the table: one-allowance amount x count"
              },
              "standard_deduction": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "object",
                    "required": [
                      "single",
                      "married_allowances_0_1",
                      "married_allowances_2_plus",
                      "head_of_household"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "single": {
                        "$ref": "#/$defs/money"
                      },
                      "married_allowances_0_1": {
                        "$ref": "#/$defs/money"
                      },
                      "married_allowances_2_plus": {
                        "$ref": "#/$defs/money"
                      },
                      "head_of_household": {
                        "$ref": "#/$defs/money"
                      }
                    }
                  }
                }
              },
              "exemption_allowance": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/money"
                    }
                  }
                },
                "description": "Table 4 amounts for counts 1..N (index = count; count 0 is 0); beyond the table: one-allowance amount x count"
              },
              "brackets": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "$ref": "#/$defs/bracketTable"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "custom_implementation": {
            "const": "custom/us_ny"
          }
        },
        "required": [
          "custom_implementation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "deduction",
              "exemption_value",
              "brackets",
              "method_iii_cutover",
              "method_iii"
            ],
            "additionalProperties": false,
            "properties": {
              "deduction": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "description": "Table B deduction allowance per payroll period and marital status",
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "object",
                    "required": [
                      "single",
                      "married"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "single": {
                        "$ref": "#/$defs/money"
                      },
                      "married": {
                        "$ref": "#/$defs/money"
                      }
                    }
                  }
                }
              },
              "exemption_value": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "description": "Table C value of one exemption per payroll period",
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "$ref": "#/$defs/money"
                  }
                }
              },
              "brackets": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "description": "Tables II-A..E and the Annual Tax Rate Schedule: over = column 1, rate = column 4, base = column 5",
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "$ref": "#/$defs/bracketTable"
                    }
                  }
                }
              },
              "method_iii_cutover": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "description": "Each bracket table's final printed line: net wages of this amount and over use Method III",
                "patternProperties": {
                  "^(daily|weekly|biweekly|semimonthly|monthly|quarterly|semiannually|annually)$": {
                    "type": "object",
                    "required": [
                      "single",
                      "married"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "single": {
                        "$ref": "#/$defs/money"
                      },
                      "married": {
                        "$ref": "#/$defs/money"
                      }
                    }
                  }
                }
              },
              "method_iii": {
                "type": "object",
                "required": [
                  "single",
                  "married"
                ],
                "additionalProperties": false,
                "description": "Page-22 top-rate bands on ANNUALIZED net wages",
                "patternProperties": {
                  "^(single|married)$": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "over",
                        "rate"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "over": {
                          "$ref": "#/$defs/money"
                        },
                        "rate": {
                          "$ref": "#/$defs/rate"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "custom_implementation": {
            "const": "custom/us_ct"
          }
        },
        "required": [
          "custom_implementation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "codes"
            ],
            "additionalProperties": false,
            "properties": {
              "codes": {
                "type": "object",
                "description": "CT-W4 withholding codes; each self-contained (shared printed tables duplicated per code)",
                "additionalProperties": false,
                "patternProperties": {
                  "^[a-f]$": {
                    "type": "object",
                    "required": [
                      "exemptions",
                      "brackets",
                      "add_back",
                      "recapture",
                      "credits"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "exemptions": {
                        "$ref": "#/$defs/rangeRows"
                      },
                      "brackets": {
                        "$ref": "#/$defs/bracketTable"
                      },
                      "add_back": {
                        "$ref": "#/$defs/rangeRows"
                      },
                      "recapture": {
                        "$ref": "#/$defs/rangeRows"
                      },
                      "credits": {
                        "$ref": "#/$defs/rangeRows"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "description": "Exact decimal as string; engine parses with Decimal"
    },
    "moneyOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/money"
        },
        {
          "type": "null"
        }
      ]
    },
    "decimal": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$",
      "description": "Exact non-negative decimal, unbounded precision (cumulative bracket bases can carry sub-cent digits)"
    },
    "rate": {
      "type": "string",
      "pattern": "^0(\\.\\d{1,6})?$|^1(\\.0{1,6})?$",
      "description": "Decimal fraction as string, 0..1, e.g. \"0.0440\""
    },
    "perStatusMoney": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/money"
      }
    },
    "sourceBlock": {
      "type": "object",
      "required": [
        "document",
        "url",
        "retrieved",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rangeRows": {
      "type": "array",
      "minItems": 1,
      "description": "Exclusive-lower-bound range rows ('More Than X'), ascending; the applicable row is the last with more_than < salary",
      "items": {
        "type": "object",
        "required": [
          "more_than",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "more_than": {
            "$ref": "#/$defs/money"
          },
          "value": {
            "$ref": "#/$defs/decimal"
          }
        }
      }
    },
    "bracketTable": {
      "type": "array",
      "minItems": 1,
      "description": "Rows ordered by ascending `over`; first row must have over == 0. A printed `base` is authoritative in computation; the loader verifies monotonicity and checks any printed base against the recomputed cumulative sum within a small tolerance (printed thresholds are rounded, base columns derive from unrounded amounts).",
      "items": {
        "type": "object",
        "required": [
          "over",
          "rate"
        ],
        "additionalProperties": false,
        "properties": {
          "over": {
            "$ref": "#/$defs/money"
          },
          "rate": {
            "$ref": "#/$defs/rate"
          },
          "base": {
            "anyOf": [
              {
                "$ref": "#/$defs/decimal"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
